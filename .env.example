# ─── Base de datos ───────────────────────────────────────────────────────────
# Postgres. En InsForge sacala con:  npx @insforge/cli db connection-string
# Para desarrollo local sirve cualquier Postgres, por ejemplo:
#   docker run -d --name english-app-db -p 5432:5432 \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=english_app postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/english_app"

# Tamaño máximo del pool de conexiones por instancia (opcional, default 5).
# En serverless conviene dejarlo bajo: cada lambda abre su propio pool.
# DATABASE_POOL_MAX=5

# ─── Autenticación ───────────────────────────────────────────────────────────
# Clave para firmar los JWT de sesión. OBLIGATORIA en producción — la app no
# arranca sin ella. Mínimo 32 caracteres. Generá una con:
#   openssl rand -base64 48
AUTH_SECRET="cambiame-por-una-clave-random-de-al-menos-32-caracteres"
